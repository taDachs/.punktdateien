{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "plugin": ["opencode-mystatus", "@tarquinen/opencode-smart-title", "opentmux", "opencode-websearch"],
  "command": {
    "mystatus": {
      "description": "Query quota usage for all AI accounts",
      "template": "Use the mystatus tool to query quota usage. Return the result as-is without modification."
    }
  },
  "tools": {
    "websearch": true,
    "codesearch": true
  },
  "permission": {
    "*": "ask",
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  },
  "provider": {
    "fzi-llm": {
      "models": {
        "Qwen/Qwen3.5-397B-A17B": {
          "family": "",
          "modalities": {
            "input": ["text", "video", "image"],
            "output": ["text"]
          },
          "options": {
            "websearch": "auto"
          },
          "name": "Qwen/Qwen3.5-397B-A17B"
        },
        "coder": {
          "name": "FZI-Coder",
          "options": {
            "websearch": "auto"
          }
        }
      },
      "name": "FZI-LLM",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://llm.fzi.de/api"
      }
    }
  }
}

{
  "$schema": "https://opencode.ai/config.json",

  "model": "openai/gpt-6.1-sol",

  "providers": {
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "settings": {
            "reasoningEffort": "high"
          },
          "variants": [
            {
              "id": "fast",
              "settings": {
                "reasoningEffort": "low"
              }
            }
          ]
        }
      }
    }
  },

  "agents": {
    "title": {
      "model": "openai/gpt-6.1-sol#fast"
    }
  },

  "plugins": [
    "@upstash/context7-opencode",
    "opencode-mem@latest",
  ],
}

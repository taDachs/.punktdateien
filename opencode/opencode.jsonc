{
  "$schema": "https://opencode.ai/config.json",

  "model": "openai/gpt-6.1-sol",

  "providers": {
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "settings": {
            "reasoningEffort": "high"
          },
          "variants": [
            {
              "id": "fast",
              "settings": {
                "reasoningEffort": "low"
              }
            }
          ]
        }
      }
    }
  },

  "agents": {
    "plan": {
      "mode": "all",
      "model": "openai/gpt-6.1-sol#high",
      "description": "Investigates requirements and develops implementation plans without changing project files"
    },
    "title": {
      "model": "openai/gpt-6.1-sol#fast"
    }
  },

  "plugins": [
    "@upstash/context7-opencode",
    "@tavily/opencode-plugin",
    "opencode-mem@latest",
  ],
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "disabled": false,
        "codemode": false
      }
    }
  },
}
